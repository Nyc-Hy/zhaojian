{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhaojian.app/schemas/final-photo-observation.schema.json",
  "title": "照见最终照片观察草案",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "observation_id",
    "source_photo_id",
    "observations",
    "uncertainties",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "contract_status": { "const": "draft" },
    "observation_id": { "$ref": "#/$defs/identifier" },
    "source_photo_id": { "$ref": "#/$defs/identifier" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/observation" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2, "maxLength": 240 }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      ],
      "items": false
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "fact", "evidence", "confidence"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["subject_relation", "attention_path", "framing", "tone", "color", "motion", "depth", "texture", "visible_artifact"]
        },
        "fact": { "type": "string", "minLength": 2, "maxLength": 300 },
        "evidence": { "type": "string", "minLength": 2, "maxLength": 300 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "region": { "$ref": "#/$defs/bbox" },
        "uncertainty": { "type": "string", "minLength": 2, "maxLength": 240 }
      }
    }
  }
}
