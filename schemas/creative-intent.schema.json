{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhaojian.app/schemas/creative-intent.schema.json",
  "title": "照见创作意图",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "creative_intent_id",
    "subject_relations",
    "attention_path",
    "keep",
    "reduce",
    "framing_intent",
    "tonal_intent",
    "color_intent",
    "motion_intent",
    "depth_intent",
    "texture_intent",
    "uncertainties",
    "tradeoffs",
    "source_analysis_id",
    "selected_interpretation_id",
    "skill_versions",
    "gear_snapshot",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "creative_intent_id": { "$ref": "#/$defs/identifier" },
    "subject_relations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "attention_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "keep": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "reduce": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "framing_intent": { "$ref": "#/$defs/intentText" },
    "tonal_intent": { "$ref": "#/$defs/nullableIntentText" },
    "color_intent": { "$ref": "#/$defs/nullableIntentText" },
    "motion_intent": { "$ref": "#/$defs/nullableIntentText" },
    "depth_intent": { "$ref": "#/$defs/nullableIntentText" },
    "texture_intent": { "$ref": "#/$defs/nullableIntentText" },
    "uncertainties": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/intentText" }
    },
    "tradeoffs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/intentText" }
    },
    "source_analysis_id": { "$ref": "#/$defs/identifier" },
    "selected_interpretation_id": { "$ref": "#/$defs/identifier" },
    "skill_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/skillSnapshot" }
    },
    "gear_snapshot": {
      "oneOf": [
        { "$ref": "#/$defs/gearSnapshot" },
        { "type": "null" }
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "intentText": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "nullableIntentText": {
      "oneOf": [
        { "$ref": "#/$defs/intentText" },
        { "type": "null" }
      ]
    },
    "skillSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "skill_version", "content_hash"],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "skill_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
          "maxLength": 64
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "gearSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "camera",
        "lens",
        "sensor_width",
        "sensor_height",
        "crop_factor",
        "focal_min",
        "focal_max",
        "maximum_aperture",
        "minimum_aperture",
        "min_iso",
        "max_iso"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/shortText" },
        "camera": { "$ref": "#/$defs/shortText" },
        "lens": { "$ref": "#/$defs/shortText" },
        "sensor_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "sensor_height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "crop_factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "focal_min": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "focal_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "maximum_aperture": { "type": "number", "minimum": 0.7, "maximum": 64 },
        "minimum_aperture": {
          "oneOf": [
            { "type": "number", "minimum": 1, "maximum": 128 },
            { "type": "null" }
          ]
        },
        "min_iso": { "type": "integer", "minimum": 25, "maximum": 1000000 },
        "max_iso": { "type": "integer", "minimum": 25, "maximum": 1000000 }
      }
    }
  }
}
