# ASP.NET Core 10 服务端配置。开发环境优先使用 README 中的 .NET User Secrets。
ASPNETCORE_URLS=http://127.0.0.1:8787
ConnectionStrings__Zhaojian=Data Source=App_Data/zhaojian.db;Cache=Shared
Model__Provider=mock
Model__Qwen__ApiKey=
Model__Qwen__Model=qwen3.7-plus
Model__Qwen__BaseUrl=https://dashscope.aliyuncs.com/compatible-mode/v1
Model__Qwen__TimeoutSeconds=300
Model__Qwen__UnderstandingCacheSeconds=600
# 2026-07-21 官方中国内地 0–256K 非思考模式目录价；优惠与最终账单可能不同。
Model__Qwen__InputPerMillionCny=2
Model__Qwen__OutputPerMillionCny=8
Model__Qwen__PricingVersion=aliyun-cn-list-0-256k-2026-07-21
Model__Qwen__PricingEffectiveAt=2026-07-21T00:00:00+08:00

# 当前是单实例内存控制；多实例部署时要替换为 Redis/PostgreSQL 实现。
ApiProtection__AnalysesPerMinute=6
ApiProtection__AccountRequestsPerFiveMinutes=20
ApiProtection__AnalysesPerDay=30
ApiProtection__MaxConcurrentAnalyses=4
ApiProtection__AnalysisQueueCapacity=512
ApiProtection__IdempotencyMinutes=10
ApiProtection__AnalysisTaskTimeoutSeconds=360
# 仅本机开发且明确需要演示密码恢复时开启；共享开发服务器保持 false。
ApiProtection__AllowLoopbackDevelopmentRecoveryCode=false

# 到期只清除服务端去元数据分析图，结构化结果仍保留。
DataRetention__AnalysisImageDays=30
DataRetention__SweepMinutes=60

# Vite 开发代理目标，仅供前端本地开发。
VITE_API_TARGET=http://127.0.0.1:8787
