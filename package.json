{
  "name": "zhaojian",
  "private": true,
  "version": "1.0.0-beta.1",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/parameter-engine"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"dotnet run --project src/Zhaojian.Api --launch-profile Development\" \"npm run dev -w @zhaojian/web\"",
    "build": "npm run build:web && dotnet build Zhaojian.slnx -v:minimal",
    "build:web": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:api": "dotnet test Zhaojian.slnx -v:minimal --no-restore",
    "evaluate:fixed": "dotnet test Zhaojian.slnx -v:minimal --filter Category=FixedEvaluation",
    "skill:evaluate": "node scripts/skill-evaluator.mjs evaluate",
    "skill:validate": "node scripts/skill-registry.mjs validate",
    "skill:audit": "node scripts/skill-registry.mjs audit",
    "skill:shadow": "node scripts/skill-registry.mjs shadow",
    "skill:promote": "node scripts/skill-registry.mjs activate",
    "skill:retire": "node scripts/skill-registry.mjs retire",
    "skill:rollback": "node scripts/skill-registry.mjs rollback",
    "skill:disable": "node scripts/skill-registry.mjs disable",
    "skill:enable": "node scripts/skill-registry.mjs enable",
    "beta:prepare": "node scripts/beta-release.mjs verify --allow-pending-live --live-status not_authorized",
    "beta:verify": "node scripts/beta-release.mjs verify",
    "beta:report": "node scripts/beta-release.mjs report",
    "skill:train:mock": "npm run skill:validate && node scripts/skill-trainer.mjs run --mode mock",
    "skill:train:live": "node scripts/skill-trainer.mjs run --mode live",
    "skill:train:cancel": "node scripts/skill-trainer.mjs cancel",
    "skill:live:plan": "node scripts/live-evaluation-campaign.mjs plan",
    "skill:live:gate": "node scripts/live-evaluation-campaign.mjs next",
    "skill:live:verify": "node scripts/live-evaluation-campaign.mjs verify",
    "skill:live:execute": "node scripts/live-evaluation-campaign.mjs execute",
    "skill:history:build": "node scripts/training-history.mjs build",
    "skill:history:replay": "node scripts/training-history.mjs replay",
    "klari": "node scripts/klari.mjs",
    "klari:setup": "npm run klari -- setup --path . --json",
    "klari:stale": "npm run klari -- stale --path . --json",
    "klari:refresh": "npm run klari -- refresh --path . --json",
    "klari:validate": "npm run klari -- validate --path . --json",
    "test:watch": "vitest",
    "validate:schema": "vitest run tests/schema-validation.test.ts",
    "dataset:acquire": "node scripts/dataset-tools.mjs acquire --allow-download",
    "dataset:seed": "node scripts/dataset-tools.mjs seed --allow-download --allow-reseed",
    "dataset:seed:holdout-v2": "node scripts/dataset-tools.mjs seed-holdout-v2 --allow-download --allow-reseed --dataset-version 2.0.0",
    "dataset:seed:holdout-v3": "node scripts/dataset-tools.mjs seed-holdout-v3 --allow-download --allow-reseed --dataset-version 3.0.0 --exposure-ledger datasets/photography-skill-v2/history/exposure-ledger.json",
    "dataset:validate": "node scripts/dataset-tools.mjs validate && node scripts/dataset-tools.mjs validate --manifest datasets/photography-skill-v2/manifest.json --splits datasets/photography-skill-v2/splits.json --assets-dir datasets/photography-skill-v2/.assets && node scripts/dataset-tools.mjs validate --manifest datasets/photography-skill-v3/manifest.json --splits datasets/photography-skill-v3/splits.json --assets-dir datasets/photography-skill-v3/.assets --exposure-ledger datasets/photography-skill-v2/history/exposure-ledger.json",
    "verify": "npm run dataset:validate && npm run validate:schema && npm test && npm run build:web && dotnet test Zhaojian.slnx -v:minimal && dotnet publish src/Zhaojian.Api/Zhaojian.Api.csproj -c Release --no-restore -v:minimal"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
